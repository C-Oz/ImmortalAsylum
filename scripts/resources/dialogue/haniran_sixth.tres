script = ExtResource("1_a47o6")
raw_dialogue = "Haniran(Haniran): What are you still doing here? You should talk to [color=yellow]Syndra down south-west of here!!![/color] 
PLAYER: I will. And can I destroy the house again? I might need to for some more… time
Haniran(Haniran)[shocked]: What?... Which house?... Oh the “quaint” architectural failure you just put there? Whatever I don’t care about it anymore.
PLAYER: That’s a bit unnecessary… "
