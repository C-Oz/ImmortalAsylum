raw_dialogue = "Onia(Onia)[happy]: Hello Giratran, thanks for creating the lake in the south! Now, would you be able to play me [color=yellow]Syndra’s theme[/color] and [color=yellow]Haniran’s Theme[/color] together? I haven’t heard those since you left."
