[resource]
script = ExtResource("1_6vm3d")
text = "If she had signs of a solution she would say something. It needs to end. Or we will meet the same fate as Goney and Havyo. But like this we are stuck in perpetual stasis Giratran. Either a solution comes soon, or we just end the whole thing."
