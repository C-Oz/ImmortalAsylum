raw_dialogue = "Onia(Onia)[happy]: Giratran! you’re back! Oh how I missed you
PLAYER[masked]: Hey Onia!
PLAYER[mask_up]: I missed you too.
Onia(Onia)[happy]: Please, if you could [color=yellow]rebuild[/color] [color=yellow]the lake[/color] and then [color=yellow]the fountain[/color] of Goney [color=yellow]south of here?[/color]"
