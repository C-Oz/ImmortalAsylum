[resource]
script = ExtResource("1_7v1n1")
raw_dialogue = "PLAYER: I should visit [color=yellow]Neneppo[/color] in the south. The stereo code for that door is as follows: The [color=#4a86e8]Clarinet[/color] should be positioned [color=yellow]East[/color], the [color=#6aa84f]Guitar[/color] should be positioned [color=yellow]West[/color] and the [color=#cc4125]Cello[/color] should be positioned [color=yellow]North[/color]."
next_state = "7"
