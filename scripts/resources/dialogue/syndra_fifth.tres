script = ExtResource("1_yyrhq")
raw_dialogue = "Syndra(Syndra)[happy]: In a way, this whole situation allowed me to escape my relationship with that idiot. I much prefer hanging out with Haniran all day haha! 
PLAYER: Hahaha, did he leave the Server in the end?
Syndra(Syndra)[sad]: Ugh I really do not care. I suppose I hope so so he wouldn’t be bothering everyone else. Although he would be bothering people on earth as a fresh android then. So we lose either way.
PLAYER: Hahaha lord, I’m glad I never met him.
Syndra(Syndra)[sad]: yeah…"
next_state = "sixth"
