[ext_resource type="Script" uid="uid://ckkcqb8nkpgwn" path="res://scripts/resources/dialogue/dialogue_sequence.gd" id="1_8tu1l"]

[resource]
script = ExtResource("1_8tu1l")
raw_dialogue = "Syndra(Syndra)[sad]: Listen Gira, you need to talk to Kryona, you are the only one who can stop her. There are rumours that she is completely obsessed with her research for a cure but there are no signs of progress for anything. We are still suffering silently.
PLAYER: … Do you have faith that she will find a solution?
Syndra(Syndra)[sad]: If she had signs of a solution she would say something. It needs to end. Or we will meet the same fate as Goney and Havyo. But like this we are stuck in perpetual stasis Giratran. Either a solution comes soon, or we just end the whole thing.
PLAYER: … I understand Syn. I will talk to her. To the gate west of here right?
Syndra(Syndra)[happy]: Yes. The [color=#4a86e8]Clarinet[/color] should be positioned [color=yellow]north[/color], the [color=#6aa84f]Guitar[/color] should be positioned [color=yellow]south[/color] and the [color=#cc4125]Cello[/color] should be positioned [color=yellow]west[/color]. Use the [color=yellow]knobs behind you[/color] to change their position in the [color=yellow]sound space.[/color]
Syndra(Syndra)[sad]: Please find Kryona and fix this. Haniran shouldn’t suffer like this any longer. 
PLAYER: Take care, Syn"
next_state = "seventh"
metadata/_custom_type_script = "uid://ckkcqb8nkpgwn"
