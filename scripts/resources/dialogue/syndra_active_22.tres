[resource]
script = ExtResource("1_a2u44")
text = "It’s locked. But different people in the fractured SUB-areas have different parts of the Stereo Code. If you can put all of them together, you should be able to access it using your instruments.
I don’t know the codes to the other areas, but I know the Stereo Code to the SUB-area east of here. "
